---
import { site } from '../data/site';

const mapQuery = encodeURIComponent(
  `${site.name}, Jaroda, Vidhan Sabha Road, Raipur, Chhattisgarh ${site.address.postalCode}`,
);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&z=15&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

const waNumber = site.contact.whatsapp.replace(/[^0-9]/g, '');
const waMessage = encodeURIComponent(
  `Hello ${site.name}, I would like to enquire about your GI pipe fittings.`,
);
const waLink = `https://wa.me/${waNumber}?text=${waMessage}`;
---

<section id="contact" class="section contact">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">Contact Us</span>
      <h2>Visit the yard. Call the manager. Get a quote today.</h2>
      <p class="lede">
        We are on Vidhan Sabha Road, 4 km from Vidhan Sabha, Raipur. Walk in for stock, call ahead for large orders,
        or drop us an email — we reply the same day.
      </p>
    </header>

    <div class="contact-grid">
      <div class="contact-cards">
        <a class="ccard" href={`tel:${site.contact.phoneRaw}`}>
          <div class="ccard-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <span class="ccard-label">Call</span>
            <strong>{site.contact.phone}</strong>
            <em>{site.contact.hours}</em>
          </div>
        </a>

        <a class="ccard" href={`mailto:${site.contact.email}`}>
          <div class="ccard-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 6-10 7L2 6"/>
            </svg>
          </div>
          <div>
            <span class="ccard-label">Email</span>
            <strong>{site.contact.email}</strong>
            <em>Reply within one business day</em>
          </div>
        </a>

        <a class="ccard" href={mapLink} target="_blank" rel="noopener">
          <div class="ccard-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <span class="ccard-label">Visit</span>
            <strong>{site.address.street}</strong>
            <em>{site.address.locality}, {site.address.city} — {site.address.postalCode}</em>
          </div>
        </a>

        <a class="ccard ccard-wa" href={waLink} target="_blank" rel="noopener">
          <div class="ccard-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.86.52 3.68 1.5 5.28L2 22l4.94-1.61a9.91 9.91 0 0 0 5.1 1.4h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.12-2.9-6.98A9.85 9.85 0 0 0 12.04 2zm5.71 14.16c-.24.68-1.4 1.3-1.95 1.38-.5.07-1.13.1-1.83-.11-.42-.13-.96-.31-1.66-.61-2.92-1.26-4.83-4.2-4.97-4.4-.15-.19-1.18-1.57-1.18-3s.75-2.13 1.02-2.42c.27-.29.58-.36.78-.36l.56.01c.18.01.42-.07.66.5.24.58.83 2.01.9 2.16.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.16-.3.36-.42.48-.14.14-.28.29-.12.57.16.29.72 1.19 1.55 1.93 1.07.96 1.98 1.25 2.26 1.4.29.14.45.12.62-.07.17-.19.72-.83.91-1.12.19-.29.38-.24.65-.14.26.1 1.66.78 1.94.93.29.14.48.21.55.34.07.12.07.72-.17 1.4z"/>
            </svg>
          </div>
          <div>
            <span class="ccard-label">WhatsApp</span>
            <strong>Chat with us instantly</strong>
            <em>For quick queries and bulk orders</em>
          </div>
        </a>
      </div>

      <div class="map-card">
        <iframe
          src={mapEmbed}
          title={`Map to ${site.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <a href={mapLink} target="_blank" rel="noopener" class="map-link">Open in Google Maps ↗</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: linear-gradient(180deg, #f2efe6 0%, #fafaf7 100%);
  }

  .section-head { text-align: center; max-width: 720px; margin: 0 auto 3rem; }
  .section-head h2 { margin: 1rem 0 0.9rem; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.6rem;
    align-items: stretch;
  }

  .contact-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .ccard {
    display: flex;
    gap: 0.9rem;
    padding: 1.2rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--charcoal);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    overflow: hidden;
  }
  .ccard > div:not(.ccard-icon) {
    min-width: 0;
    flex: 1;
  }
  .ccard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: rgba(200,16,46,0.35);
  }

  .ccard-icon {
    flex-shrink: 0;
    width: 42px; height: 42px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(200,16,46,0.12), rgba(200,16,46,0.02));
    color: var(--red);
    display: grid;
    place-items: center;
  }
  .ccard-icon svg { width: 22px; height: 22px; }

  .ccard-label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }
  .ccard strong {
    display: block;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--charcoal);
    overflow-wrap: anywhere;
    word-break: break-word;
    line-height: 1.35;
  }
  .ccard em {
    overflow-wrap: anywhere;
  }
  .ccard em {
    font-style: normal;
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  .ccard-wa .ccard-icon {
    background: linear-gradient(135deg, rgba(37,211,102,0.15), rgba(37,211,102,0.02));
    color: #25d366;
  }

  .map-card {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    min-height: 340px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  .map-card iframe {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    border: 0;
  }
  .map-link {
    position: absolute;
    right: 12px; bottom: 12px;
    background: rgba(255,255,255,0.95);
    color: var(--red);
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(6px);
  }
  .map-link:hover { background: var(--red); color: #fff; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .map-card { min-height: 300px; order: -1; }
  }

  @media (max-width: 560px) {
    .contact-cards { grid-template-columns: 1fr; gap: 0.75rem; }
    .ccard { padding: 1rem; }
    .ccard strong { font-size: 0.94rem; word-break: break-word; }
    .ccard em { font-size: 0.76rem; }
    .map-card { min-height: 260px; }
    .map-link { right: 8px; bottom: 8px; padding: 0.4rem 0.7rem; font-size: 0.76rem; }
  }
</style>
