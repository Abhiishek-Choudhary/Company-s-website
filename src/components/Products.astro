---
import { products, videos } from '../data/site';
---

<section id="products" class="section products">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">Products</span>
      <h2>The Complete GI Fitting Range</h2>
      <p class="lede">
        From half-inch domestic plumbing to four-inch industrial mains — every GI fitting you need,
        cast to ISI IS 1879 standards, hot-dip galvanized, and ready to install.
      </p>
    </header>

    <div class="product-grid">
      {products.map((p) => (
        <a href={`/products/#${p.slug}`} class="product-card" aria-label={`View ${p.name} details and photos`} data-astro-prefetch>
          <div class="product-thumb">
            <img src={p.images[0]} alt={`${p.name} — Jai Santoshi Casting Company`} loading="lazy" width="320" height="220" />
          </div>
          <div class="product-body">
            <h3>{p.name}</h3>
            <div class="sizes">Sizes: <strong>{p.sizes}</strong></div>
            <p>{p.short}</p>
            <span class="product-link">View details →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="products-cta">
      <a href="/products/" class="btn btn-primary">Browse the full product catalogue →</a>
    </div>

    <div class="video-block">
      <header class="section-head">
        <span class="eyebrow">Watch & Learn</span>
        <h2>Understanding GI Fittings</h2>
        <p class="lede">
          A quick visual guide to the fittings we manufacture and how they are used in real plumbing systems.
        </p>
      </header>

      <div class="video-grid">
        {videos.map((v, i) => (
          <figure class="video-card">
            <div class="video-wrap">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                title={v.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
            <figcaption>{v.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .products { background: linear-gradient(180deg, #fafaf7 0%, #f2efe6 100%); }

  .section-head { text-align: center; max-width: 700px; margin: 0 auto 3rem; }
  .section-head h2 { margin: 1rem 0 0.9rem; }
  .section-head .lede { color: var(--slate); font-size: 1.05rem; }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 1.2rem;
  }

  .product-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    color: inherit;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    position: relative;
    overflow: hidden;
  }
  .product-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--red), var(--gold));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
    z-index: 2;
  }
  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: rgba(200,16,46,0.35);
  }
  .product-card:hover::before { transform: scaleX(1); }
  .product-card:hover .product-thumb img { transform: scale(1.06); }

  .product-thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(135deg, #f2efe6, #e8e6df);
  }
  .product-thumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-body {
    padding: 1.15rem 1.25rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .product-card h3 { font-size: 1.1rem; }
  .sizes {
    font-size: 0.8rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .sizes strong { color: var(--charcoal); font-weight: 600; }
  .product-card p { font-size: 0.88rem; color: var(--slate); flex: 1; }
  .product-link {
    align-self: flex-start;
    margin-top: 0.3rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--red);
    padding: 0.25rem 0;
    border-bottom: 1.5px solid transparent;
    transition: border-color 0.18s ease;
  }
  .product-card:hover .product-link { border-color: var(--red); }

  .products-cta {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }

  .video-block { margin-top: 5rem; }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 1.4rem;
  }

  @media (max-width: 560px) {
    .section-head { margin-bottom: 2.2rem; }
    .product-grid { gap: 0.9rem; }
    .product-card { padding: 1.3rem 1.15rem; }
    .video-block { margin-top: 3.5rem; }
    .video-grid { gap: 1rem; }
  }

  .video-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .video-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }

  .video-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    border: 0;
  }

  .video-card figcaption {
    padding: 0.95rem 1.1rem 1.1rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--slate);
  }
</style>
