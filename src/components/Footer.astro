---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="foot-brand">
      <div class="foot-logo">
        <span>JS</span>
        <div>
          <strong>{site.name}</strong>
          <em>{site.tagline}</em>
        </div>
      </div>
      <p>{site.description.slice(0, 180)}…</p>
    </div>

    <div class="foot-cols">
      <div>
        <h4>Explore</h4>
        <a href="/">Home</a>
        <a href="/#about">About</a>
        <a href="/products/">Products</a>
        <a href="/#contact">Contact</a>
      </div>

      <div>
        <h4>Products</h4>
        <a href="/products/">GI Elbow</a>
        <a href="/products/">GI Tee</a>
        <a href="/products/">GI Socket</a>
        <a href="/products/">GI Union</a>
        <a href="/products/">GI Nipple</a>
      </div>

      <div>
        <h4>Reach Us</h4>
        <a href={`tel:${site.contact.phoneRaw}`}>{site.contact.phone}</a>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <address>
          {site.address.street},<br/>
          {site.address.locality}, {site.address.city},<br/>
          {site.address.state} — {site.address.postalCode}
        </address>
      </div>
    </div>
  </div>

  <div class="foot-bottom">
    <div class="container fb-row">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span class="credit">Website made by <strong>Abhishek Choudhary</strong></span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0f1216;
    color: rgba(255,255,255,0.75);
    padding-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
  }

  .foot-logo {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .foot-logo span {
    width: 46px; height: 46px;
    border-radius: 10px;
    display: grid; place-items: center;
    background: linear-gradient(135deg, var(--red), var(--red-dark));
    color: var(--gold);
    font-family: 'Playfair Display', serif;
    font-weight: 800;
  }
  .foot-logo strong {
    display: block;
    font-family: 'Playfair Display', serif;
    color: #fff;
    font-size: 1.1rem;
  }
  .foot-logo em {
    display: block;
    font-style: normal;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.55);
  }
  .foot-brand p {
    font-size: 0.92rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.65;
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .foot-cols h4 {
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .foot-cols a, .foot-cols address {
    display: block;
    font-size: 0.92rem;
    color: rgba(255,255,255,0.7);
    padding: 0.28rem 0;
    font-style: normal;
    line-height: 1.55;
    transition: color 0.18s ease;
  }
  .foot-cols a:hover { color: var(--gold); }

  .foot-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 1.3rem 0;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.5);
  }
  .fb-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .credit strong { color: var(--gold); font-weight: 600; }

  @media (max-width: 820px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2.2rem; }
    .foot-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 480px) {
    .site-footer { padding-top: 3rem; }
    .footer-inner { padding-bottom: 2rem; }
    .foot-cols { grid-template-columns: 1fr; gap: 1.5rem; }
    .foot-cols a, .foot-cols address { font-size: 0.88rem; }
    .fb-row { flex-direction: column; text-align: center; gap: 0.5rem; }
    .fb-row span { font-size: 0.78rem; }
  }
</style>
