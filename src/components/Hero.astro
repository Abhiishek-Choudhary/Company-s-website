---
import { leadership, site } from '../data/site';

const slides = [
  {
    kicker: 'Since ' + site.founded,
    headline: 'GI Fittings Built to Last a Century',
    sub:
      'Precision-cast, hot-dip galvanized pipe fittings trusted by government buildings, contractors, and plumbers across Chhattisgarh.',
    accent: 'Install once. Rely on it for generations.',
  },
  {
    kicker: 'Leadership',
    headline: 'A Legacy of Trust — Sanjeev Agarwal',
    sub:
      'Director Sanjeev Agarwal leads Jai Santoshi Casting Company with an uncompromising commitment to material quality and craftsmanship.',
    accent: 'Every fitting bears our name — and our word.',
    person: leadership[0],
  },
  {
    kicker: 'Operations',
    headline: 'On Time, Every Time — Krishna Kumar Chaudhary',
    sub:
      'Manager Krishna Kumar Chaudhary personally ensures every order — from a single elbow to a full government contract — leaves the yard on schedule.',
    accent: 'Reliable people. Reliable products.',
    person: leadership[1],
  },
];
---

<section id="home" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-grid"></div>
  </div>

  <div class="container hero-inner">
    <div class="slider" data-slider>
      {slides.map((slide, i) => (
        <article class={`slide${i === 0 ? ' is-active' : ''}`} data-slide aria-hidden={i !== 0}>
          <div class="slide-copy">
            <span class="eyebrow">{slide.kicker}</span>
            {i === 0 ? <h1>{slide.headline}</h1> : <h2 class="slide-title">{slide.headline}</h2>}
            <p class="lede">{slide.sub}</p>
            <p class="accent">{slide.accent}</p>
            <div class="hero-ctas">
              <a href="#products" class="btn btn-primary">Explore Products →</a>
              <a href="#contact" class="btn btn-ghost">Get a Quote</a>
            </div>
            <ul class="hero-badges">
              <li><strong>ISI</strong><span>IS 1879 standard</span></li>
              <li><strong>100+ yrs</strong><span>Install-once lifespan</span></li>
              <li><strong>Govt</strong><span>Buildings trusted</span></li>
            </ul>
          </div>

          <div class="slide-visual">
            {slide.person ? (
              <figure class="portrait">
                <img
                  src={slide.person.photo}
                  alt={`${slide.person.name}, ${slide.person.role} — ${site.name}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'portrait-fallback',textContent:this.alt.split(',')[0].split(' ').map(w=>w[0]).join('').slice(0,2)}))"
                />
                <figcaption>
                  <span class="p-name">{slide.person.name}</span>
                  <span class="p-role">{slide.person.role}</span>
                </figcaption>
              </figure>
            ) : (
              <div class="product-showcase" role="img" aria-label="Galvanized iron pipe fittings display">
                <svg viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="metal" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#e8ecef"/>
                      <stop offset="0.5" stop-color="#a8b2bc"/>
                      <stop offset="1" stop-color="#5a6570"/>
                    </linearGradient>
                    <radialGradient id="metal-r" cx="0.35" cy="0.35" r="0.75">
                      <stop offset="0" stop-color="#f4f7f9"/>
                      <stop offset="1" stop-color="#4a5461"/>
                    </radialGradient>
                  </defs>
                  <g transform="translate(150 150)">
                    <circle r="120" fill="url(#metal-r)" opacity="0.9"/>
                    <circle r="120" fill="none" stroke="#2a2f36" stroke-width="4"/>
                    <circle r="80" fill="#1a1a1a"/>
                    <circle r="80" fill="none" stroke="url(#metal)" stroke-width="3"/>
                    {Array.from({length: 24}).map((_, k) => (
                      <line
                        x1={Math.cos(k * Math.PI / 12) * 100}
                        y1={Math.sin(k * Math.PI / 12) * 100}
                        x2={Math.cos(k * Math.PI / 12) * 118}
                        y2={Math.sin(k * Math.PI / 12) * 118}
                        stroke="#2a2f36" stroke-width="2"
                      />
                    ))}
                  </g>
                </svg>
                <div class="showcase-label">Galvanized Iron Fittings</div>
              </div>
            )}
          </div>
        </article>
      ))}

      <div class="slider-controls">
        <button class="slider-btn" data-prev aria-label="Previous slide">‹</button>
        <div class="slider-dots" role="tablist">
          {slides.map((_, i) => (
            <button
              class={`dot${i === 0 ? ' is-active' : ''}`}
              data-dot={i}
              role="tab"
              aria-label={`Go to slide ${i + 1}`}
            ></button>
          ))}
        </div>
        <button class="slider-btn" data-next aria-label="Next slide">›</button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: 6rem;
    padding-bottom: 3rem;
    display: flex;
    align-items: center;
    background: linear-gradient(180deg, #0f1216 0%, #1a1f26 60%, #232a33 100%);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-orb {
    position: absolute;
    width: 520px; height: 520px;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.35;
  }
  .hero-orb-1 {
    background: radial-gradient(circle, #c8102e, transparent 65%);
    top: -120px; left: -80px;
  }
  .hero-orb-2 {
    background: radial-gradient(circle, #ffd447, transparent 60%);
    bottom: -140px; right: -60px;
    opacity: 0.22;
  }

  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
  }

  .hero-inner {
    width: 100%;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .slider { position: relative; }

  .slide {
    display: none;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    animation: fade-up 0.6s ease both;
  }
  .slide.is-active { display: grid; }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .eyebrow {
    background: rgba(255, 212, 71, 0.12);
    color: var(--gold);
    border-color: rgba(255, 212, 71, 0.3);
  }

  .slide h1,
  .slide .slide-title {
    color: #fff;
    margin: 1.2rem 0 1rem;
    font-size: clamp(1.85rem, 5.2vw + 0.4rem, 3.6rem);
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .lede {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.08rem;
    max-width: 55ch;
  }

  .accent {
    margin-top: 1.1rem;
    color: var(--gold);
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.05rem;
  }

  .hero-ctas {
    margin-top: 2rem;
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero-badges {
    margin-top: 2.5rem;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 480px;
  }
  .hero-badges li {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    backdrop-filter: blur(4px);
  }
  .hero-badges strong {
    color: var(--gold);
    font-size: 1.05rem;
    font-weight: 700;
    font-family: 'Playfair Display', serif;
  }
  .hero-badges span {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.78rem;
  }

  .slide-visual {
    display: grid;
    place-items: center;
    position: relative;
  }

  .portrait {
    position: relative;
    width: min(360px, 100%);
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background: var(--steel);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 212, 71, 0.25),
      inset 0 0 0 6px rgba(255, 255, 255, 0.04);
  }

  .portrait::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 20px;
    padding: 2px;
    background: linear-gradient(135deg, var(--gold), transparent 40%, var(--red) 100%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  .portrait img {
    width: 100%; height: 100%;
    object-fit: cover;
  }

  :global(.portrait-fallback) {
    width: 100%; height: 100%;
    display: grid;
    place-items: center;
    font-family: 'Playfair Display', serif;
    font-size: clamp(4rem, 8vw, 6rem);
    font-weight: 800;
    color: rgba(255, 212, 71, 0.85);
    background: var(--steel);
    letter-spacing: 0.05em;
  }

  .portrait figcaption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1.5rem 1.4rem 1.2rem;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.85));
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .p-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
  }
  .p-role {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--gold);
  }

  .product-showcase {
    position: relative;
    width: min(360px, 100%);
    aspect-ratio: 1;
    background: radial-gradient(circle at 35% 30%, #2a2f36 0%, #0f1216 100%);
    border-radius: 24px;
    display: grid;
    place-items: center;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 212, 71, 0.2);
    padding: 2rem;
  }
  .product-showcase svg { width: 80%; height: auto; }
  .showcase-label {
    position: absolute;
    bottom: 1.4rem;
    font-family: 'Playfair Display', serif;
    color: var(--gold);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
  }

  .slider-controls {
    margin-top: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    padding: 0.75rem 1.4rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 212, 71, 0.28);
    border-radius: 999px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .slider-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 212, 71, 0.55);
    background: rgba(255, 212, 71, 0.08);
    color: var(--gold);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: all 0.18s ease;
    display: grid;
    place-items: center;
  }
  .slider-btn:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--charcoal);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 212, 71, 0.35);
  }

  .slider-dots { display: flex; gap: 0.55rem; align-items: center; }
  .dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }
  .dot:hover { border-color: var(--gold); }
  .dot.is-active {
    background: var(--gold);
    border-color: var(--gold);
    width: 32px;
    border-radius: 999px;
    box-shadow: 0 0 0 3px rgba(255, 212, 71, 0.18);
  }

  @media (max-width: 820px) {
    .hero { padding-top: 5rem; }
    .slide { grid-template-columns: 1fr; gap: 1.5rem; text-align: center; }
    .slide-copy { display: flex; flex-direction: column; align-items: center; }
    .lede { text-align: center; }
    .slide-visual { order: -1; margin-bottom: 0.5rem; }
    .portrait, .product-showcase { width: min(260px, 78vw); }
    .hero-ctas { justify-content: center; }
    .hero-badges {
      margin-top: 2rem;
      max-width: 100%;
      width: 100%;
    }
    .slider-controls { margin-top: 2rem; }
  }

  @media (max-width: 560px) {
    .hero { padding-top: 4.5rem; padding-bottom: 2rem; }
    .lede { font-size: 0.98rem; }
    .accent { font-size: 0.98rem; }
    .hero-ctas { flex-direction: column; width: 100%; gap: 0.6rem; }
    .hero-ctas :global(.btn) { width: 100%; justify-content: center; padding: 0.9rem 1.2rem; }
    .hero-badges { gap: 0.5rem; }
    .hero-badges li { padding: 0.6rem 0.55rem; }
    .hero-badges strong { font-size: 0.92rem; }
    .hero-badges span { font-size: 0.68rem; line-height: 1.25; }
    .portrait, .product-showcase { width: min(230px, 72vw); }
    .p-name { font-size: 1.15rem; }
    .p-role { font-size: 0.72rem; letter-spacing: 0.12em; }
    .portrait figcaption { padding: 1.1rem 1rem 0.9rem; }
    .slider-controls {
      margin-top: 1.75rem;
      gap: 1rem;
      padding: 0.55rem 1rem;
    }
    .slider-btn { width: 40px; height: 40px; font-size: 1.3rem; }
    .dot { width: 10px; height: 10px; }
    .dot.is-active { width: 28px; }
  }

  @media (max-width: 360px) {
    .hero-badges { grid-template-columns: repeat(3, 1fr); }
    .hero-badges strong { font-size: 0.82rem; }
    .hero-badges span { font-size: 0.62rem; }
    .portrait, .product-showcase { width: min(210px, 78vw); }
  }
</style>

<script>
  const slider = document.querySelector('[data-slider]');
  if (slider) {
    const slides = slider.querySelectorAll<HTMLElement>('[data-slide]');
    const dots = slider.querySelectorAll<HTMLElement>('[data-dot]');
    let current = 0;
    let timer: number | undefined;

    function go(next: number) {
      const total = slides.length;
      const i = ((next % total) + total) % total;
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      dots[current]?.classList.remove('is-active');
      slides[i].classList.add('is-active');
      slides[i].setAttribute('aria-hidden', 'false');
      dots[i]?.classList.add('is-active');
      current = i;
    }

    function auto() {
      clearInterval(timer);
      timer = window.setInterval(() => go(current + 1), 6000);
    }

    slider.querySelector('[data-prev]')?.addEventListener('click', () => { go(current - 1); auto(); });
    slider.querySelector('[data-next]')?.addEventListener('click', () => { go(current + 1); auto(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); auto(); }));

    slider.addEventListener('mouseenter', () => clearInterval(timer));
    slider.addEventListener('mouseleave', auto);
    auto();
  }
</script>
