---
import { site } from '../data/site';

const waNumber = site.contact.whatsapp.replace(/[^0-9]/g, '');
const waMessage = encodeURIComponent(
  `Hello ${site.name}, I would like to enquire about your GI pipe fittings.`,
);
const waLink = `https://wa.me/${waNumber}?text=${waMessage}`;
---

<a
  class="wa-fab"
  href={waLink}
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp"
  title="Chat with us on WhatsApp"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.86.52 3.68 1.5 5.28L2 22l4.94-1.61a9.91 9.91 0 0 0 5.1 1.4h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.12-2.9-6.98A9.85 9.85 0 0 0 12.04 2zm5.71 14.16c-.24.68-1.4 1.3-1.95 1.38-.5.07-1.13.1-1.83-.11-.42-.13-.96-.31-1.66-.61-2.92-1.26-4.83-4.2-4.97-4.4-.15-.19-1.18-1.57-1.18-3s.75-2.13 1.02-2.42c.27-.29.58-.36.78-.36l.56.01c.18.01.42-.07.66.5.24.58.83 2.01.9 2.16.07.14.12.31.02.5-.1.19-.15.31-.29.48-.14.16-.3.36-.42.48-.14.14-.28.29-.12.57.16.29.72 1.19 1.55 1.93 1.07.96 1.98 1.25 2.26 1.4.29.14.45.12.62-.07.17-.19.72-.83.91-1.12.19-.29.38-.24.65-.14.26.1 1.66.78 1.94.93.29.14.48.21.55.34.07.12.07.72-.17 1.4z"/>
  </svg>
  <span class="wa-label">Chat on WhatsApp</span>
  <span class="wa-pulse" aria-hidden="true"></span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.15rem 0.9rem 1rem;
    background: #25d366;
    color: #fff;
    border-radius: 999px;
    box-shadow: 0 12px 28px rgba(37, 211, 102, 0.45), 0 4px 10px rgba(0, 0, 0, 0.15);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    isolation: isolate;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .wa-fab:hover,
  .wa-fab:focus-visible {
    transform: translateY(-3px) scale(1.02);
    background: #1ebe57;
    box-shadow: 0 16px 34px rgba(37, 211, 102, 0.55), 0 6px 12px rgba(0, 0, 0, 0.18);
  }

  .wa-fab:focus-visible {
    outline: 3px solid rgba(255, 212, 71, 0.85);
    outline-offset: 2px;
  }

  .wa-fab svg {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  .wa-pulse {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: #25d366;
    opacity: 0.55;
    animation: wa-pulse 2.2s ease-out infinite;
  }

  @keyframes wa-pulse {
    0%   { transform: scale(1);   opacity: 0.55; }
    80%  { transform: scale(1.4); opacity: 0;    }
    100% { transform: scale(1.4); opacity: 0;    }
  }

  @media (max-width: 560px) {
    .wa-fab {
      padding: 0.85rem;
      gap: 0;
    }
    .wa-label {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .wa-fab svg { width: 28px; height: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-pulse { animation: none; opacity: 0; }
  }
</style>
